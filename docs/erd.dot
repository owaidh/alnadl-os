// docs/erd.dot — Entity Relationship Diagram (Q15).
// Generated by hand from db.js's actual CREATE TABLE statements, grouped
// into logical clusters for readability. Regenerate the PNG with:
//   dot -Tpng docs/erd.dot -o docs/erd.png
digraph ERD {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#FEFCF9", color="#C08A3E", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#8A7C63"];
  graph [fontname="Helvetica", fontsize=14, labelloc=t, label="Alnadl Hospitality OS — Entity Relationship Diagram (v2.0.3 + P5-Inc-1/2/3/4/5/6/7)"];

  subgraph cluster_tenancy {
    label="Tenancy & Site (§6, §5)"; style=dashed; color="#A6752F";
    partners; properties; zones; points; qr_tokens; outlets; outlet_availability;
  }
  subgraph cluster_catalog {
    label="Catalog"; style=dashed; color="#A6752F";
    categories; products; variants; addons; merchants;
  }
  subgraph cluster_orders {
    label="Orders & Fulfillment (§8, §13, §3)"; style=dashed; color="#A6752F";
    orders; order_items; child_orders; payments; refunds; fulfillment;
  }
  subgraph cluster_financial {
    label="Financial (§9, §10)"; style=dashed; color="#A6752F";
    revenue_models; revenue_ledger; settlements; settlement_events;
  }
  subgraph cluster_loyalty {
    label="Loyalty & Wallet"; style=dashed; color="#A6752F";
    loyalty_accounts; loyalty_transactions; wallet_accounts; wallet_transactions;
  }
  subgraph cluster_engage {
    label="ALNADL Engage — Phase 5 (P5-Inc-1/2/3/4/5/6/7)"; style=dashed; color="#2E5C4B";
    engage_pass; engage_session; engage_outbox; engage_audit_log;
    mechanic; mechanic_version; moment; payload_version; venue_policy_override;
    experience_event; response_event;
    customer_engage_profile; exposure_memory; novelty_evaluation;
    group_room; engage_participant;
    engage_provider_call; generation_evaluation; safety_evaluation;
  }

  subgraph cluster_platform {
    label="Platform"; style=dashed; color="#A6752F";
    plans; subscriptions; partner_branding; users; audit_log; notifications;
    promotions; feedback; qr_analytics_events; schema_migrations;
  }

  moment -> engage_provider_call [label="1:N", color="#2E5C4B"];
  moment -> generation_evaluation [label="1:1 (optional)", color="#2E5C4B", style=dashed];
  moment -> safety_evaluation [label="1:1", color="#2E5C4B"];
  engage_provider_call -> generation_evaluation [label="1:1 (optional)", color="#2E5C4B", style=dashed];

  engage_session -> group_room [label="1:N", color="#2E5C4B"];
  group_room -> engage_participant [label="1:N", color="#2E5C4B"];

  customer_engage_profile -> exposure_memory [label="1:N", color="#2E5C4B"];
  mechanic -> exposure_memory [label="1:N (optional)", color="#2E5C4B", style=dashed];
  moment -> novelty_evaluation [label="1:1", color="#2E5C4B"];

  engage_session -> experience_event [label="1:N", color="#2E5C4B"];
  moment -> experience_event [label="1:N (optional)", color="#2E5C4B", style=dashed];
  moment -> response_event [label="1:N", color="#2E5C4B"];

  engage_session -> moment [label="1:N", color="#2E5C4B"];
  moment -> payload_version [label="1:1", color="#2E5C4B"];
  mechanic -> mechanic_version [label="1:N", color="#2E5C4B"];
  mechanic_version -> moment [label="1:N", color="#2E5C4B"];

  orders -> engage_outbox [label="1:N (order.confirmed)", color="#2E5C4B", style=bold];
  orders -> engage_pass [label="1:N", color="#2E5C4B", style=bold];
  engage_pass -> engage_session [label="1:N"];

  partners -> properties [label="1:N"];
  properties -> zones [label="1:N"];
  zones -> points [label="1:N"];
  points -> qr_tokens [label="1:N"];
  properties -> outlets [label="1:N"];
  outlets -> outlet_availability [label="1:N (optional)"];
  properties -> categories [label="1:N"];
  categories -> products [label="1:N"];
  outlets -> products [label="1:N", style=bold];
  products -> variants [label="1:N"];
  products -> addons [label="1:N"];
  properties -> merchants [label="1:N (Phase 3, superseded by outlets)", style=dotted];

  points -> orders [label="1:N"];
  orders -> order_items [label="1:N", color="#8C2E28"];
  orders -> child_orders [label="1:N (multi-outlet only)", style=bold, color="#8C2E28"];
  child_orders -> order_items [label="1:N", style=dashed];
  outlets -> child_orders [label="1:N"];
  orders -> payments [label="1:N", color="#8C2E28"];
  orders -> refunds [label="1:N", color="#8C2E28"];
  orders -> fulfillment [label="1:1"];

  outlets -> revenue_models [label="1:N (active=1 unique)"];
  orders -> revenue_ledger [label="1:N", color="#8C2E28"];
  outlets -> revenue_ledger [label="1:N", color="#8C2E28"];
  partners -> settlements [label="1:N"];
  settlements -> settlement_events [label="1:N"];

  loyalty_accounts -> loyalty_transactions [label="1:N"];
  partners -> wallet_accounts [label="1:N"];
  wallet_accounts -> wallet_transactions [label="1:N"];

  plans -> subscriptions [label="1:N"];
  partners -> subscriptions [label="1:1 active"];
  partners -> partner_branding [label="1:1"];
  partners -> users [label="1:N (scope)"];
  qr_tokens -> qr_analytics_events [label="1:N"];
  properties -> promotions [label="1:N"];
  orders -> feedback [label="1:1"];
}
